{
  "name": "dock-one",
  "version": "26.1.0",
  "description": "Dock (1) — Minimalist Docker & Compose Manager inspired by Nothing OS",
  "author": "Julien0ff <contact@thefoxy.me>",
  "homepage": "https://docker.thefoxy.me",
  "repository": {
    "type": "git",
    "url": "https://github.com/Julien0ff/App-docker.git"
  },
  "main": "electron/main.js",
  "scripts": {
    "dev": "concurrently -n \"api,web\" -c \"cyan,magenta\" \"node server/index.js\" \"vite\"",
    "build": "vite build",
    "start": "NODE_ENV=production node server/index.js",
    "app": "electron .",
    "app:dev": "concurrently -n \"api,web,electron\" -c \"cyan,magenta,yellow\" \"node server/index.js\" \"vite\" \"electron .\"",
    "app:dist": "npm run build && electron-builder --publish never",
    "app:dist:linux": "npm run build && electron-builder --linux deb AppImage tar.gz --publish never",
    "app:dist:mac": "npm run build && electron-builder --mac dmg zip --publish never",
    "app:dist:win": "npm run build && electron-builder --win nsis zip --publish never",
    "service:setup": "bash scripts/setup-service.sh"
  },
  "keywords": [],
  "type": "commonjs",
  "dependencies": {
    "clsx": "^2.1.1",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "lucide-react": "^1.66.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "ws": "^8.22.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.2",
    "autoprefixer": "^10.6.2",
    "concurrently": "^10.0.6",
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0",
    "postcss": "^8.5.32",
    "tailwindcss": "^3.4.19",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  },
  "build": {
    "appId": "com.julien0ff.dockone",
    "productName": "Dock (1)",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "server/**/*",
      "electron/**/*",
      "package.json"
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb",
        "tar.gz"
      ],
      "category": "Development",
      "maintainer": "Julien0ff <contact@thefoxy.me>"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.developer-tools"
    },
    "win": {
      "target": [
        "nsis",
        "zip"
      ]
    }
  }
}
